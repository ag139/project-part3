pipeline {
    agent { label 'ci-agent' }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        REGISTRY       = 'docker.io'
        REGISTRY_REPO  = 'ayeletgeulayev'
        BUILDKIT_HOST  = 'unix:///home/user/.local/share/buildkit/buildkitd.sock'
        MAX_CRITICAL   = '10'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.GIT_SHA   = sh(script: 'git rev-parse --short=12 HEAD', returnStdout: true).trim()
                    env.GIT_BRANCH_NAME = sh(script: 'git rev-parse --abbrev-ref HEAD', returnStdout: true).trim()
                    env.IMAGE_TAG = env.GIT_SHA
                }
                sh '''
                  echo "branch:       ${GIT_BRANCH_NAME}"
                  echo "commit:       ${GIT_SHA}"
                  echo "build number: ${BUILD_NUMBER}"
                  echo "image tag:    ${IMAGE_TAG}"
                '''
            }
        }

        stage('Validation') {
            steps {
                sh '''
                  set -e
                  for f in docker/backend/Dockerfile docker/frontend/Dockerfile docker/worker/Dockerfile; do
                    test -f "$f" || { echo "missing $f"; exit 1; }
                  done
                  test -d k8s || { echo "missing k8s directory"; exit 1; }
                  test -f helm/devops-app/Chart.yaml || { echo "missing helm chart"; exit 1; }
                  echo "project structure OK"

                  grep -rn ":latest" docker/*/Dockerfile && { echo "latest tag found in Dockerfile"; exit 1; } || true
                  echo "no latest tags in Dockerfiles"

                  echo "=== observability manifests and dashboards ==="
                  python3 scripts/validate-observability.py
                '''
            }
        }

        stage('Lint') {
            steps {
                container('python') {
                    sh '''
                      set -e
                      export PIP_TARGET=$WORKSPACE/.pip
                      export PATH=$PIP_TARGET/bin:$PATH
                      export PYTHONPATH=$PIP_TARGET:$PYTHONPATH
                      pip install --quiet --no-cache-dir -r tests/requirements.txt

                      echo "=== ruff: style, correctness and security rules ==="
                      ruff check docker/backend docker/worker tests \
                        --output-format=concise | tee lint-report.txt

                      echo
                      echo "=== bandit: python security analysis ==="
                      bandit -r docker/backend docker/worker \
                        -f txt -o bandit-report.txt --severity-level medium || true
                      cat bandit-report.txt

                      if grep -qE "Severity: (High|Medium)" bandit-report.txt; then
                        echo "bandit reported a medium or high severity issue"
                        exit 1
                      fi
                      echo "static analysis passed"
                    '''
                }
                archiveArtifacts artifacts: 'lint-report.txt,bandit-report.txt', allowEmptyArchive: true
            }
        }

        stage('Tests') {
            steps {
                container('python') {
                    sh '''
                      set -e
                      export PIP_TARGET=$WORKSPACE/.pip
                      export PATH=$PIP_TARGET/bin:$PATH
                      export PYTHONPATH=$PIP_TARGET:$PYTHONPATH
                      pip install --quiet --no-cache-dir -r tests/requirements.txt
                      mkdir -p test-results
                      python -m pytest tests/ \
                        --junitxml=test-results/results.xml \
                        -v
                    '''
                }
            }
            post {
                always {
                    junit 'test-results/results.xml'
                }
            }
        }

        stage('Build and Push') {
            steps {
                container('buildkit') {
                    withCredentials([usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'REG_USER',
                        passwordVariable: 'REG_PASS')]) {
                        sh '''
                          set -e
                          mkdir -p /home/user/.docker
                          AUTH=$(printf "%s:%s" "$REG_USER" "$REG_PASS" | base64 | tr -d '\\n')
                          cat > /home/user/.docker/config.json <<JSON
{"auths":{"https://index.docker.io/v1/":{"auth":"$AUTH"}}}
JSON

                          for svc in backend frontend worker; do
                            echo "building $svc"
                            buildctl build \\
                              --frontend dockerfile.v0 \\
                              --local context=docker/$svc \\
                              --local dockerfile=docker/$svc \\
                              --opt build-arg:APP_VERSION=${IMAGE_TAG} \\
                              --opt build-arg:GIT_SHA=${GIT_SHA} \\
                              --opt build-arg:RELEASE=${BUILD_NUMBER} \\
                              --output type=image,name=${REGISTRY_REPO}/devops-app-$svc:${IMAGE_TAG},push=true \\
                              --metadata-file $(pwd)/meta-$svc.json
                          done
                        '''
                    }
                }
            }
        }

        stage('Scan Images') {
            steps {
                container('trivy') {
                    withCredentials([usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'REG_USER',
                        passwordVariable: 'REG_PASS')]) {
                        sh '''
                          set -e
                          export TRIVY_USERNAME="$REG_USER"
                          export TRIVY_PASSWORD="$REG_PASS"
                          export TRIVY_CACHE_DIR="$WORKSPACE/.trivycache"
                          export XDG_CACHE_HOME="$WORKSPACE/.cache"
                          mkdir -p "$TRIVY_CACHE_DIR" "$XDG_CACHE_HOME"
                          mkdir -p scan-reports
                          FAILED=0
                          for svc in backend frontend worker; do
                            REF="${REGISTRY_REPO}/devops-app-${svc}:${IMAGE_TAG}"
                            echo "=============================================="
                            echo "scanning ${REF}"
                            echo "=============================================="

                            trivy image --scanners vuln --no-progress \
                              --severity HIGH,CRITICAL \
                              --format table \
                              "${REF}" | tee "scan-reports/${svc}.txt"

                            trivy image --scanners vuln --no-progress \
                              --severity HIGH,CRITICAL \
                              --format json \
                              --output "scan-reports/${svc}.json" \
                              "${REF}"

                            CRIT=$(trivy image --scanners vuln --no-progress \
                                    --severity CRITICAL --format json "${REF}" \
                                    | grep -o '"Severity": *"CRITICAL"' | wc -l)

                            echo "${svc}: ${CRIT} critical findings"
                            echo "${svc}=${CRIT}" >> scan-reports/critical-counts.txt

                            if [ "${CRIT}" -gt "${MAX_CRITICAL}" ]; then
                              echo "POLICY VIOLATION: ${svc} has ${CRIT} critical findings, limit is ${MAX_CRITICAL}"
                              FAILED=1
                            fi
                          done

                          echo
                          echo "=== critical findings per image ==="
                          cat scan-reports/critical-counts.txt

                          if [ "$FAILED" -eq 1 ]; then
                            echo "one or more images exceeded the critical vulnerability policy"
                            exit 1
                          fi
                          echo "all images are within the agreed policy"
                        '''
                    }
                }
                archiveArtifacts artifacts: 'scan-reports/*', fingerprint: true
            }
        }

        stage('Publish Metadata') {
            steps {
                container('buildkit') {
                    sh '''
                      set -e
                      : > image-metadata.txt
                      echo "GIT_COMMIT=${GIT_SHA}" >> image-metadata.txt
                      echo "BUILD_NUMBER=${BUILD_NUMBER}" >> image-metadata.txt
                      echo "IMAGE_TAG=${IMAGE_TAG}" >> image-metadata.txt
                      for svc in backend frontend worker; do
                        DIGEST=$(tr ',' '\n' < meta-$svc.json | grep containerimage.digest | grep -o 'sha256:[a-f0-9]*')
                        echo "IMAGE_${svc}=${REGISTRY_REPO}/devops-app-$svc:${IMAGE_TAG}" >> image-metadata.txt
                        echo "DIGEST_${svc}=${DIGEST}" >> image-metadata.txt
                      done
                      cat image-metadata.txt
                    '''
                }
                archiveArtifacts artifacts: 'image-metadata.txt', fingerprint: true
            }
        }
    }

    post {
        always {
            sh 'rm -f /home/user/.docker/config.json 2>/dev/null || true'
            deleteDir()
        }
        success {
            echo "CI succeeded. Image tag ${env.IMAGE_TAG} is ready for deployment."
            build job: 'cd-application',
                  wait: false,
                  parameters: [
                      string(name: 'IMAGE_TAG',        value: env.IMAGE_TAG),
                      string(name: 'TARGET_NAMESPACE', value: 'devops-app'),
                      string(name: 'CI_BUILD_NUMBER',  value: env.BUILD_NUMBER)
                  ]
        }
        failure {
            echo "CI failed. No image was promoted for deployment."
        }
    }
}
