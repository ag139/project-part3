{
  "title": "Application Overview",
  "uid": "app-overview",
  "tags": ["application", "sli"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(http_requests_total{namespace=\"devops-app\"}, service)",
        "refresh": 1,
        "includeAll": true,
        "multi": true
      },
      {
        "name": "pod",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(http_requests_total{namespace=\"devops-app\"}, pod)",
        "refresh": 1,
        "includeAll": true,
        "multi": true
      },
      {
        "name": "release",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(app_info, version)",
        "refresh": 1,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Running version",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "app_info{namespace=\"devops-app\"}", "legendFormat": "{{version}} / build {{release}}", "instant": true }
      ],
      "options": { "textMode": "name", "colorMode": "none" }
    },
    {
      "type": "stat",
      "title": "Availability (SLO 99%)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [ { "expr": "app:availability5m", "instant": true } ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.95 },
              { "color": "green", "value": 0.99 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "p95 latency (SLO 1s)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [ { "expr": "app:latency_p95_5m", "instant": true } ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Requests per second",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [ { "expr": "app:request_rate5m", "instant": true } ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "type": "timeseries",
      "title": "Traffic by endpoint",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum by (endpoint) (rate(http_requests_total{namespace=\"devops-app\",service=~\"$service\",pod=~\"$pod\"}[5m]))",
          "legendFormat": "{{endpoint}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "type": "timeseries",
      "title": "Error ratio",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [ { "expr": "app:error_rate5m", "legendFormat": "5xx ratio" } ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 } }
    },
    {
      "type": "timeseries",
      "title": "Latency percentiles",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"devops-app\"}[5m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"devops-app\"}[5m])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"devops-app\"}[5m])))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "Business: users registered and files uploaded",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "sum(rate(users_registered_total{namespace=\"devops-app\"}[5m])) * 300", "legendFormat": "users per 5m" },
        { "expr": "sum(rate(files_uploaded_total{namespace=\"devops-app\"}[5m])) * 300", "legendFormat": "uploads per 5m" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Dependency failures",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 20 },
      "targets": [
        { "expr": "sum by (dependency) (rate(dependency_failures_total{namespace=\"devops-app\"}[5m]))", "legendFormat": "{{dependency}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU by pod",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 20 },
      "targets": [
        { "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"devops-app\",container!=\"\"}[5m]))", "legendFormat": "{{pod}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "type": "timeseries",
      "title": "Memory by pod",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 20 },
      "targets": [
        { "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"devops-app\",container!=\"\"})", "legendFormat": "{{pod}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    }
  ]
}
