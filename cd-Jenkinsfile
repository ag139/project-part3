pipeline {
    agent { label 'cd-agent' }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 20, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    parameters {
        string(name: 'IMAGE_TAG', defaultValue: '', description: 'Immutable image tag produced by CI. latest is rejected.')
        string(name: 'TARGET_NAMESPACE', defaultValue: 'devops-app', description: 'Target namespace.')
        string(name: 'CI_BUILD_NUMBER', defaultValue: '', description: 'CI build number, for traceability.')
    }

    environment {
        REGISTRY_REPO   = 'ayeletgeulayev'
        RELEASE_NAME    = 'devops-app'
        CHART_PATH      = './helm/devops-app'
        ALLOWED_NS      = 'devops-app'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                sh '''
                  echo "deploy requested by: ${BUILD_USER_ID:-$(echo $BUILD_TAG)}"
                  echo "cd build number:     ${BUILD_NUMBER}"
                  echo "ci build number:     ${CI_BUILD_NUMBER}"
                  echo "image tag:           ${IMAGE_TAG}"
                  echo "target namespace:    ${TARGET_NAMESPACE}"
                  echo "chart:               ${CHART_PATH}"
                '''
            }
        }

        stage('Input Validation') {
            steps {
                script {
                    if (!params.IMAGE_TAG?.trim()) {
                        error "IMAGE_TAG is required. Provide the tag produced by the CI pipeline."
                    }
                    if (params.IMAGE_TAG.trim().toLowerCase() == 'latest') {
                        error "IMAGE_TAG must be immutable. latest is not accepted."
                    }
                    if (params.TARGET_NAMESPACE.trim() != env.ALLOWED_NS) {
                        error "Namespace ${params.TARGET_NAMESPACE} is not permitted. Allowed: ${env.ALLOWED_NS}"
                    }
                    echo "tag ${params.IMAGE_TAG} accepted: not empty, not latest, namespace permitted"
                }
                container('crane') {
                    sh '''
                        set -e
                        if ! command -v crane >/dev/null 2>&1; then
                          apk add --no-cache curl tar >/dev/null 2>&1
                          curl -sSL "https://github.com/google/go-containerregistry/releases/download/v0.20.3/go-containerregistry_Linux_x86_64.tar.gz" \
                            | tar -xz -C /usr/local/bin crane
                        fi
                        crane version
                        MISSING=0
                        for svc in backend frontend worker; do
                          REF="${REGISTRY_REPO}/devops-app-${svc}:${IMAGE_TAG}"
                          echo "verifying ${REF} exists in the registry"
                          if DIGEST=$(crane digest "${REF}" 2>/dev/null); then
                            echo "${REF} confirmed, digest ${DIGEST}"
                            echo "${svc}=${DIGEST}" >> resolved-digests.txt
                          else
                            echo "ERROR: ${REF} was not found in the registry"
                            MISSING=1
                          fi
                        done

                        if [ "$MISSING" -eq 1 ]; then
                          echo
                          echo "one or more images are missing from the registry."
                          echo "refusing to deploy a tag that has not been published by CI."
                          exit 1
                        fi

                        echo
                        echo "=== all images verified, digests resolved ==="
                        cat resolved-digests.txt
                    '''
                }
                archiveArtifacts artifacts: 'resolved-digests.txt', allowEmptyArchive: true
            }
        }

        stage('Manifest Validation') {
            steps {
                container('tools') {
                    sh '''
                      set -e
                      helm version --short
                      helm lint ${CHART_PATH}
                      helm template ${RELEASE_NAME} ${CHART_PATH} \
                        --namespace ${TARGET_NAMESPACE} \
                        --set image.registry=${REGISTRY_REPO}/ \
                        --set image.tag=${IMAGE_TAG} > /tmp/rendered.yaml
                      echo "rendered objects:"
                      grep -c "^kind:" /tmp/rendered.yaml
                      kubectl create --dry-run=client -f /tmp/rendered.yaml -o name > /dev/null 2>&1 \
                      || echo "note: local validation reported existing resources, which is expected on redeploy"
                      echo "manifest validation passed"
                '''
                }
            }
        }

        stage('Authenticate') {
            steps {
                container('tools') {
                    sh '''
                      set -e
                      echo "authenticating with the in-cluster ServiceAccount"
                      kubectl config current-context || true
                      echo "permission check for the target namespace:"
                      kubectl auth can-i update deployments -n ${TARGET_NAMESPACE}
                      kubectl auth can-i delete deployments -n ${TARGET_NAMESPACE} || echo "delete not permitted, as intended"
                '''
                }
            }
        }

        stage('Deploy') {
            steps {
                container('tools') {
                    sh '''
                      set -e
                      helm upgrade --install ${RELEASE_NAME} ${CHART_PATH} \
                        --namespace ${TARGET_NAMESPACE} \
                        --set image.registry=${REGISTRY_REPO}/ \
                        --set image.tag=${IMAGE_TAG} \
                        --set secrets.dbUser=app \
                        --reuse-values \
                        --wait --timeout 5m
                '''
                }
            }
        }

        stage('Rollout') {
            steps {
                container('tools') {
                    sh '''
                      set -e
                      for dep in backend frontend worker; do
                        kubectl rollout status deployment/${dep} -n ${TARGET_NAMESPACE} --timeout=180s
                      done
                '''
                }
            }
        }

        stage('Verify') {
            steps {
                container('tools') {
                    sh '''
                      set -e
                      echo "=== deployments ==="
                      kubectl get deployments -n ${TARGET_NAMESPACE}
                      echo
                      echo "=== pods ==="
                      kubectl get pods -n ${TARGET_NAMESPACE} -o wide
                      echo
                      echo "=== services ==="
                      kubectl get services -n ${TARGET_NAMESPACE}
                      echo
                      echo "=== running images ==="
                      RUNNING=$(kubectl get pods -n ${TARGET_NAMESPACE} -o jsonpath='{..image}' | tr ' ' '\\n' | sort -u)
                      echo "$RUNNING"
                      echo
                      for svc in backend frontend worker; do
                        echo "$RUNNING" | grep -q "devops-app-${svc}:${IMAGE_TAG}" \
                          && echo "${svc} is running the requested tag ${IMAGE_TAG}" \
                          || { echo "${svc} is NOT running ${IMAGE_TAG}"; exit 1; }
                      done
                '''
                }
            }
        }

        stage('Smoke Test') {
            steps {
                container('tools') {
                    sh '''
                      set -e
                      echo "calling the application through its in-cluster Service"
                      BODY=$(wget -qO- --timeout=15 "http://frontend.${TARGET_NAMESPACE}.svc.cluster.local/")
                      echo "response: ${BODY}"
                      echo "${BODY}" | grep -q "app is running" || { echo "unexpected response"; exit 1; }

                      USERS=$(wget -qO- --timeout=15 "http://frontend.${TARGET_NAMESPACE}.svc.cluster.local/users")
                      echo "users endpoint: ${USERS}"

                      echo "smoke test passed"
                '''
                }
            }
        }
    }

    post {
        success {
            container('tools') {
                sh '''
              echo "===================================================="
              echo "deployment succeeded"
              echo "  image tag:      ${IMAGE_TAG}"
              echo "  namespace:      ${TARGET_NAMESPACE}"
              echo "  release:        ${RELEASE_NAME}"
              echo "  cd build:       ${BUILD_NUMBER}"
              echo "  originating ci: ${CI_BUILD_NUMBER}"
              echo "===================================================="
              helm history ${RELEASE_NAME} -n ${TARGET_NAMESPACE} --max 5
                '''
            }
        }
        failure {
            container('tools') {
                sh '''
              echo "deployment failed. collecting diagnostics."
              echo "=== pods ==="
              kubectl get pods -n ${TARGET_NAMESPACE} -o wide || true
              echo
              echo "=== recent events ==="
              kubectl get events -n ${TARGET_NAMESPACE} \
                --sort-by=.metadata.creationTimestamp | tail -25 || true
              echo
              echo "=== helm history ==="
              helm history ${RELEASE_NAME} -n ${TARGET_NAMESPACE} --max 5 || true
              echo
              echo "TO ROLL BACK, run:"
              echo "  helm rollback ${RELEASE_NAME} -n ${TARGET_NAMESPACE}"
              echo "or roll back a single deployment:"
              echo "  kubectl rollout undo deployment/backend -n ${TARGET_NAMESPACE}"
                '''
            }
        }
        always {
            deleteDir()
        }
    }
}
